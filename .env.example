# --- LLM ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Local fallback (ollama run llama3.1:8b)
OLLAMA_MODEL=llama3.1:8b
OLLAMA_HOST=http://localhost:11434

# --- App ---
PORT=8001
DATA_DIR=./data
CHECK_INTERVAL_MINUTES=5
HEADLESS=true
DRY_RUN=false
# DRY_RUN=true → browser steps are simulated, boarding pass is a dummy file (for testing without hitting airlines)

# --- Seat + meal preferences (defaults; editable in UI, per-booking overrides possible) ---
SEAT_TYPE=window
SEAT_ZONE=front
PREFERRED_SEAT=
EXIT_ROW_OK=false
MAX_SEAT_PRICE_INR=1500
MEAL_PREF=veg
PREFERRED_MEAL=
MAX_MEAL_PRICE_INR=1000
# Agent ALWAYS stops before payment (never pays, OTP needs you).
# PAYMENT_HANDOFF_MINUTES>0 + HEADLESS=false keeps the browser open at the pay page.
PAYMENT_HANDOFF_MINUTES=0

# --- Notifications (all optional, console always on) ---
# Email via SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL_TO=

# Telegram (create bot via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp via Twilio
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+91XXXXXXXXXX

# --- WhatsApp bot (Meta Cloud API, free) — see DEPLOY.md ---
# Your bot number's Phone Number ID + token from developers.facebook.com
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
# Any secret string you invent; paste the same in Meta's webhook Verify Token field
META_WA_VERIFY_TOKEN=change-me-verify-token
# Meta app secret (App Settings → Basic) — enables webhook signature checks
META_WA_APP_SECRET=
# Family allowlist: who may use the bot (digits, comma-separated). Empty = anyone.
FAMILY_PHONES=+91XXXXXXXXXX,+91YYYYYYYYYY
# Optional approved utility template for alerts outside the 24h chat window
META_WA_TEMPLATE=
META_WA_TEMPLATE_LANG=en

# --- QR bridge (unofficial, spare number only) — see README "QR bridge" ---
# Python alerts POST here when Meta is not configured.
WA_BRIDGE_URL=http://127.0.0.1:8002
# Shared secret between wa-bridge/ and the API. Set both sides to the same value.
WA_BRIDGE_SECRET=change-me-bridge-secret
# Bridge's view of the API + its own listen port.
BOT_URL=http://127.0.0.1:8001
BRIDGE_PORT=8002

# --- Gmail watcher (optional) ---
# Put Google OAuth client_secret.json at ./client_secret.json, then open /gmail/auth once.
GMAIL_ENABLED=false
